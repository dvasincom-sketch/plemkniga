# --- База данных PostgreSQL ---
# Локально (docker compose): postgres://postgres:postgres@postgres:5432/plemkniga
# Timeweb Cloud (управляемый PostgreSQL): строку подключения возьмите в панели,
# при внешнем подключении обычно нужен ?sslmode=verify-full или ?sslmode=require
DATABASE_URI=postgres://postgres:postgres@localhost:5432/plemkniga

# --- Payload ---
# Секрет для подписи JWT. Сгенерировать: openssl rand -base64 32
PAYLOAD_SECRET=change-me-please-32-chars-minimum

# Публичный адрес приложения (используется в письмах и ссылках админки)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Разрешить сид-скрипт (в проде выключите)
SEED_ENABLED=true
