# --- База данных PostgreSQL ---
# Локально (docker compose): postgres://postgres:postgres@postgres:5432/plemkniga
# Timeweb Cloud (управляемый PostgreSQL): строку подключения возьмите в панели,
# при внешнем подключении обычно нужен ?sslmode=verify-full или ?sslmode=require
DATABASE_URI=postgres://postgres:postgres@localhost:5432/plemkniga

# --- Payload ---
# Секрет для подписи JWT. Сгенерировать: openssl rand -base64 32
PAYLOAD_SECRET=change-me-please-32-chars-minimum

# Публичный адрес приложения (используется в письмах и ссылках админки)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Запасные домены, показывающие ту же книгу, — через запятую.
# Служебное имя площадки работает раньше собственного домена, и без этой
# строки по нему открывается всё, кроме входа: Payload сверяет источник
# запроса со списком доверенных, и отказ выглядит как поломка входа.
# ALT_HOSTS=dvasincom-sketch-plemkniga-6202.twc1.net

# Разрешить сид-скрипт (в проде выключите)
SEED_ENABLED=true

# Ключ к замеру производительности на проде.
#
# Пока переменной нет, маршрут /bench отвечает «страница не найдена» —
# не «доступ запрещён», а именно не существует: ручка, сообщающая о своём
# существовании, приглашает подбирать ключ.
#
# Задаётся на время замера и убирается после. Не короче шестнадцати
# знаков — более короткий ключ маршрут не примет и останется закрытым.
# BENCH_TOKEN=

# Ключ к прогону проверок.
#
# Устроен так же, как BENCH_TOKEN, и намеренно отдельный: у ручек разная
# цена ошибки и разная частота. Общий ключ пришлось бы менять сразу
# в двух действиях, и однажды поменяли бы в одном.
#
# В отличие от замера, этот ключ живёт постоянно: прогон запускается
# по расписанию каждую ночь. Не короче шестнадцати знаков.
#
#   export CHECKS_TOKEN=$(grep -m1 '^CHECKS_TOKEN=' .env | cut -d= -f2-)
#   curl -sS -G -w '\n%{http_code}\n' "https://адрес/checks" \
#     --data-urlencode "token=$CHECKS_TOKEN" --data-urlencode "label=Прод"
#
# Первая строка нужна потому, что этот файл читает сервер, а не терминал:
# без неё уходит пустой ключ, ручка отвечает «не найдено», и выглядит это
# как неверный токен. Причину отказа пишет лог сервера поимённо.
#
# Метка передаётся через --data-urlencode, а не строкой в адресе:
# кириллица уходит сырыми байтами, и разбор HTTP отвечает «плохой запрос»
# ещё до того, как дело дойдёт до маршрута. Снаружи это выглядит как
# поломка ручки, хотя ручка её и не видела.
#
# Код ответа говорит об исходе: 200 — всё сошлось, 409 — есть находки.
# Ночному действию не нужно разбирать тело, чтобы понять, звать ли людей.
# CHECKS_TOKEN=

# Счётчик посещаемости Яндекс.Метрики. Пусто — счётчика нет вовсе.
# Без приставки NEXT_PUBLIC_: идентификатор читает серверная раскладка
# и передаёт его в разметку, поэтому смена счётчика не требует пересборки.
# На страницах за входом счётчик молчит независимо от этой переменной —
# разбор в src/components/Metrika.tsx.
# YANDEX_METRIKA_ID=112283097
